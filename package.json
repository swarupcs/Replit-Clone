{
  "name": "replit-clone",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @replit-clone/shared build && pnpm --filter @replit-clone/server dev",
    "dev:web": "pnpm --filter @replit-clone/shared build && pnpm --filter @replit-clone/web dev",
    "dev:split": "node scripts/dev-split.mjs",
    "build": "pnpm --filter @replit-clone/shared build && pnpm --parallel --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "images:prepare": "pnpm --filter @replit-clone/shared build && node -e \"require('fs').copyFileSync('packages/shared/dist/network.js','images/egress/network.js')\"",
    "images:build": "pnpm images:prepare && docker build -t sandbox-node:latest images/node && docker build -t sandbox-python:latest images/python && docker build -t sandbox-go:latest images/go && docker build -t sandbox-egress:latest images/egress",
    "db:up": "docker compose up -d",
    "ports": "node --env-file-if-exists=apps/server/.env scripts/ports.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2",
      "@prisma/client",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.67.0"
  }
}
