# Settings for putting this stack on a real name, behind Caddy, with TLS.
#
#   cp .env.expose.example .env
#   docker compose -f docker-compose.prod.yml -f docker-compose.expose.yml up -d --build
#
# READ docs/EXPOSING.md FIRST. What you are exposing runs arbitrary code in
# containers on a host whose Docker socket is mounted into the server, and a
# tunnel (Tailscale, Cloudflare) is very likely the better answer for a machine
# behind NAT -- it needs none of this file.

# The domain the editor, the API and previews all hang off. Three A/AAAA
# records must already point at this host before the first boot: Caddy asks a
# certificate authority for certificates on startup and a name that does not
# resolve yet fails that request.
#
#   ide.example.com       the editor
#   api.example.com       the API, the terminal and the socket
#   preview.example.com   project previews -- the user's own code
DOMAIN=example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- the base stack's own settings ------------------------------------------

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- published sites --------------------------------------------------------
#
# Off. Turning them on needs two things docs/EXPOSING.md explains:
#
#   - a SECOND registrable domain, because the preview cookie is scoped to
#     DOMAIN above and a published site is arbitrary user code that would
#     otherwise receive it. The server refuses to start on that combination.
#   - a WILDCARD certificate, so the DNS-01 challenge, so a Caddy image built
#     with your DNS provider's plugin. See deploy/Caddyfile.
#
# DEPLOY_PORT=3002
# DEPLOY_ORIGIN=https://example.net

# --- the sandbox ------------------------------------------------------------
#
# Defaults to true in the overlay, unlike the LAN stack. Requires
# `pnpm images:build` to have built sandbox-egress:latest on this host --
# without it, package installs inside projects will fail.
SANDBOX_EGRESS_FILTERED=true
