VITE_BACKEND_URL=http://localhost:3000

# Origin serving project previews. Optional.
#
# Leave it unset and previews are served from the API's own origin, which is
# the simplest setup and the least safe one: a project's code -- including any
# dependency it installs -- then runs same-origin with the API and can mint
# itself an access token from the session cookie. The editor compensates by
# withholding `allow-same-origin` from the preview iframe, which costs the
# project's own app localStorage, cookies and IndexedDB.
#
# Point this at a separate origin and that trade goes away: the origin boundary
# does the isolating, and the iframe gets `allow-same-origin` back -- which it
# needs, because a frame without it has an OPAQUE origin, and `<script
# type="module">` is always fetched in CORS mode. Those requests go out as
# `Origin: null`, match no allowlist, and are blocked: the HTML arrives and
# nothing in it runs. A server-rendered app still shows its markup, so this
# looks like a white pane for React/Vue/Svelte and like success for Next.
#
# The server serves previews on PREVIEW_PORT (the API's port plus one by
# default), so locally this is just the API host on that port. A different PORT
# is a different origin, which is all that is required.
VITE_PREVIEW_ORIGIN=http://localhost:3101
