VITE_BACKEND_URL=http://localhost:3000

# Origin serving project previews. Optional.
#
# Leave it unset and previews are served from the API's own origin, which is
# the simplest setup and the least safe one: a project's code -- including any
# dependency it installs -- then runs same-origin with the API and can mint
# itself an access token from the session cookie. The editor compensates by
# withholding `allow-same-origin` from the preview iframe, which costs the
# project's own app localStorage, cookies and IndexedDB.
#
# Point this at a separate host and that trade goes away: the origin boundary
# does the isolating, and the iframe gets its storage APIs back.
# VITE_PREVIEW_ORIGIN=https://preview.yourdomain.com
