generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tier as offered: what it is called, what it costs, and the numbers it
/// buys.
///
/// In the database rather than in code so that an operator can change a limit
/// without a deploy, and seeded by the migration that creates it so that a
/// fresh deployment has a `free` plan before its first signup. The seeded
/// numbers are exactly the `env` defaults that used to be the only limits
/// there were, which is what makes introducing this a behavioural no-op.
///
/// Only limits that are about an ACCOUNT are here. The machine's own limits --
/// MAX_CONCURRENT_CONTAINERS, CONTAINER_MEMORY_MB, DEPLOY_MEMORY_MB -- stay in
/// `env`, because a plan may promise more of what this platform allocates and
/// never more than the host has. See plan.md section 6, decision 15.
model Plan {
  /// A stable string, not a uuid: it is written in config, in a Stripe price's
  /// metadata, and in this file's own seed. A generated key would make those
  /// three disagree the first time anybody restored a database.
  id String @id

  label String

  /// Minor units. A price is not a float, and this one is never arithmetic
  /// anyway -- the charge is Stripe's to compute; this is what the screen says.
  priceCents Int    @default(0)
  currency   String @default("usd")

  /// Display order, and the only thing that makes "upgrade" a meaningful word.
  rank Int @default(0)

  maxProjects          Int
  userDiskQuotaMb      Int
  projectDiskQuotaMb   Int
  aiRequestsPerHour    Int
  maxContainersPerUser Int

  /// Minutes a container may sit unattached before it is stopped; 0 is never.
  /// See EntitlementLimits.idleMinutes. Defaulted so the column can be added
  /// without a value for every plan that already exists.
  idleMinutes Int @default(20)

  managedDatabases Boolean @default(false)
  customDomains    Boolean @default(false)

  /// Whether a devcontainer.json on this plan may ask for extra host mounts.
  /// Gated again by DEVCONTAINER_MOUNT_ROOTS, which is empty by default.
  devcontainerMounts Boolean @default(false)
  scheduledJobs    Boolean @default(false)

  /// Withdrawn from the catalogue without being deleted. Accounts already on
  /// it keep every number: a plan that stops being sold is not a plan that
  /// stops being honoured, and deleting the row would silently move those
  /// accounts to the free tier -- which is the same class of mistake as
  /// deleting a customer's data when they stop paying.
  archivedAt DateTime?

  users User[]

  subscriptions Subscription[]

  @@map("plans")
}

model User {
  id    String @id @default(uuid())
  email String @unique

  /// Null for an account created through an identity provider, which has no
  /// password of its own to store.
  passwordHash String?

  /// Set once the address has been confirmed. Unverified accounts can still
  /// sign in — locking people out of a tool they just signed up for is worse
  /// than the risk — but the state is recorded so it can be acted on.
  emailVerifiedAt DateTime?

  /// GitHub's numeric user id, when the account is linked. Stable across
  /// username changes, which is why it and not the login is what is stored.
  githubId  String? @unique
  avatarUrl String?

  createdAt DateTime @default(now())

  /// What this account is entitled to. Defaults to the free plan, which the
  /// migration seeds, so every account that existed before plans did lands on
  /// limits identical to the ones it already had.
  ///
  /// Restrict, not Cascade or SetNull: deleting a plan out from under the
  /// accounts on it is the one operation this table must refuse. Archive it.
  planId String @default("free")
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  /// Limits set for this one account, overriding the plan's. A partial of the
  /// same shape, validated on read.
  ///
  /// Json rather than a nullable column per limit, which would duplicate every
  /// column of `plans` onto `users` and have to be added twice forever. The
  /// cost is that it is unvalidated at rest, so it is parsed through a schema
  /// on the way out and a row that fails falls back to the PLAN -- never to
  /// something more generous. Garbage must not be a way to buy a bigger quota.
  ///
  /// This column is not a nicety. Comping a customer, extending a trial and
  /// grandfathering an early account are the same operation, and without it
  /// each one ends in somebody inventing a plan row for one person.
  entitlementOverride Json?

  /// Why, in an operator's words. An override with no account of itself is the
  /// half of the record that makes the other half unfalsifiable -- the same
  /// argument the moderation trail makes about a reinstatement.
  overrideReason String?

  /// When the override lapses, or null for one that does not. A trial that has
  /// to be remembered to be ended is a trial that never ends.
  overrideUntil DateTime?

  /// Set when this account was told it was nearly out of room, and cleared
  /// when it no longer is. One bit, because it is what makes the warning a
  /// notification about a CHANGE rather than a recurring reminder.
  ///
  /// Here rather than derived from the notifications table, which is pruned:
  /// deriving it would have the pruner decide to warn somebody again.
  quotaWarnedAt DateTime?

  projects         Project[]
  refreshTokens    RefreshToken[]
  collaborations   ProjectCollaborator[]
  reportsFiled     ProjectReport[]
  tokens           UserToken[]
  githubConnection GithubConnection?
  notifications    Notification[]
  apiKeys          ApiKey[]
  accountActions   AccountAction[]       @relation("AccountActionSubject")
  computeUsage     ComputeUsage[]
  subscription     Subscription?

  /// "Which accounts are on this plan" is the operator's question, and the one
  /// a pricing change has to answer before it is made.
  @@index([planId])
  @@map("users")
}

/// A long-lived credential for something that is not a person.
///
/// `UserToken` is single-use, arrives by email and lives an hour; this is the
/// opposite object on every axis, which is why it is not that table with a
/// third purpose. It is presented on every request, for months, from a CI
/// runner -- so the design questions are entirely different ones: what it may
/// do, how it is revoked, and whether anybody can tell it was used.
///
/// The secret is shown once, at creation, and stored only as a hash. There is
/// no route that returns it again, because there is nothing to return.
model ApiKey {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What its owner called it. The only way to know which runner to go and
  /// change after revoking one.
  label String

  /// The public half, stored in the clear and shown in the list: it is in the
  /// presented secret and is what the lookup keys on, so a key can be
  /// identified without the database holding anything that would let it be
  /// used. Unique because it is the lookup.
  prefix String @unique

  /// SHA-256 of the whole presented string. See `UserToken.tokenHash` for the
  /// same reasoning: a leaked database must not hand over live credentials.
  tokenHash String @unique

  /// What this key may do, from a small closed set. Stored as a list rather
  /// than as booleans so that adding a scope does not migrate every row.
  scopes String[]

  /// When it was last accepted. Written at most once a minute rather than on
  /// every request -- the question it answers is "is anything still using
  /// this", and that question does not need second-level resolution or a
  /// database write per call.
  lastUsedAt DateTime?

  /// Optional. A key that expires is one nobody has to remember to remove.
  expiresAt DateTime?

  /// Revocation is a timestamp, not a delete: "this key was revoked on
  /// Tuesday" is the answer somebody needs after an incident, and a deleted
  /// row answers nothing.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  /// The listing is one account's keys, newest first.
  @@index([userId, createdAt])
  @@map("api_keys")
}

/// What an operator did to an ACCOUNT, as opposed to a project.
///
/// A second audit table rather than a third kind of `ModerationAction`, and
/// the reason is that table's own invariant: every row in it names a project,
/// and `projectName` is copied into it precisely so the record still reads
/// after the project is gone. An action against an account has no project, so
/// fitting one in would mean making that column nullable -- loosening a
/// constraint that is doing real work, to hold an event that is not the same
/// conversation. §2.17 put the appeal in the moderation table because "taken
/// down, appealed, reinstated" only reads in order; "moved to Pro" is not part
/// of that sequence and would appear in the project's trail as noise.
///
/// Same discipline otherwise: the actor is stored rather than joined, the
/// subject's address is copied so the record survives the account, and a
/// reason is required by the API for every action here -- an operator who can
/// silently change what somebody pays for is a worse position than this
/// product was in before the console existed.
model AccountAction {
  id String @id @default(uuid())

  /// SetNull, like the moderation trail and for the same reason: a record that
  /// vanishes with its subject can be erased by deleting the subject.
  subjectUserId String?
  subject       User?   @relation("AccountActionSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  /// Copied at the time, so the trail still says whose account it was.
  subjectEmail  String

  action AccountActionType

  /// The operator's address, from `ADMIN_EMAILS`. Stored rather than joined:
  /// that list is config, and somebody removed from it still did what they did.
  actor String

  /// Required by the API, unlike a moderation decision's.
  reason String

  /// What changed, in words, for a person reading the trail later: "free to
  /// pro", "maxProjects 20 to 50". Not a diff to replay -- a sentence to read.
  detail String?

  createdAt DateTime @default(now())

  /// One account's history, and the console's recent feed.
  @@index([subjectUserId, createdAt])
  @@index([createdAt])
  @@map("account_actions")
}

enum AccountActionType {
  /// An operator moved this account to a different plan.
  PLAN_CHANGED
  /// An operator set limits for this account by hand, over its plan's.
  OVERRIDE_SET
  /// ...and took them away again, leaving the plan's.
  OVERRIDE_CLEARED
}

/// One-time tokens for flows that arrive by email.
///
/// A single table rather than one per purpose: they share every field, the
/// same hashing, the same expiry handling, and the same "used exactly once"
/// rule. Only the purpose differs.
model UserToken {
  id String @id @default(uuid())

  /// SHA-256 of the token. The value goes in the email and is never stored, so
  /// a leaked database does not hand over anyone's account.
  tokenHash String @unique

  purpose UserTokenPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Someone other than the owner who may open a project.
model ProjectCollaborator {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  /// One row per person per project.
  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_collaborators")
}

enum ProjectRole {
  /// May read files and watch the preview. Cannot write, run, or open a shell.
  VIEWER
  /// Everything the owner can do except delete the project or manage access.
  EDITOR
}

/// One issued refresh token.
///
/// Refresh tokens used to be stateless JWTs, so signing out only cleared the
/// browser's cookie: anyone holding the value kept a working session for its
/// full lifetime, and a compromised account could not be cut off short of
/// rotating the signing secret and ending every session on the platform.
model RefreshToken {
  id String @id @default(uuid())

  /// SHA-256 of the token. The value itself is never stored, so a leaked
  /// database backup does not hand over live sessions.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set when the token is rotated or explicitly revoked. A token presented
  /// after this is a replay, and revokes its whole family — the standard
  /// signal that a token was stolen.
  revokedAt DateTime?

  /// Groups every token descended from one sign-in.
  familyId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Somebody telling the operator that a public project should not be public.
///
/// Only public projects can be reported, because a private one is visible to
/// nobody but its owner and the people they invited -- there is no audience to
/// protect and nothing a stranger could have seen to object to.
model ProjectReport {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Who reported it. SetNull rather than Cascade: a report outlives the
  /// account that filed it, because deleting your account must not quietly
  /// withdraw a complaint somebody has yet to act on. The report stays, and
  /// stops naming anybody.
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  reason  ProjectReportReason
  /// What the reporter wrote, if anything. Capped by the request schema rather
  /// than by the column, so the limit can be explained in the error.
  details String?

  status     ProjectReportStatus @default(OPEN)
  /// When an operator last acted on it, and which one.
  reviewedAt DateTime?
  reviewedBy String?

  createdAt DateTime @default(now())

  /// One open report per person per project. Without it, a single account can
  /// file the same complaint a thousand times and bury every other report in
  /// the queue -- the review queue is the scarce resource here, not the
  /// database.
  @@unique([projectId, reporterId])
  @@index([status, createdAt])
  @@map("project_reports")
}

enum ProjectReportReason {
  /// Credentials, keys, or personal data the owner probably did not mean to
  /// publish. First because it is the one where speed matters and where the
  /// owner is usually grateful rather than aggrieved.
  SECRETS
  ABUSE
  MALWARE
  INFRINGEMENT
  OTHER
}

enum ProjectReportStatus {
  OPEN
  /// Looked at, nothing wrong. Kept rather than deleted so that a project
  /// reported and cleared ten times reads differently from one never reported.
  DISMISSED
  /// Acted on: the project was made private.
  ACTIONED
}

/// A command this project runs on a schedule, without anybody being here.
///
/// The unit of always-on compute that is NOT a server. A deployment answers
/// requests and is therefore always running; a scheduled job runs for a minute
/// and stops, which is the cheap half of "always on" and the half most people
/// actually want — a nightly backup, an hourly fetch, a weekly digest.
///
/// The schedule is a five-field cron expression **in UTC**, parsed by
/// `lib/cron.ts` rather than by a library, and `nextRunAt` is the answer to it.
/// Storing the answer rather than re-deriving it every sweep is what lets the
/// sweeper be one indexed query instead of a scan that parses every row.
model ScheduledJob {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What the owner calls it. Shown in the list and in the run history.
  name String

  /// Five cron fields, UTC. See `lib/cron.ts` for the dialect.
  schedule String

  /// Run through `/bin/sh -lc` inside the project's own container.
  ///
  /// A shell, deliberately: the sandbox is the security boundary here, not the
  /// argv array. Whoever writes this already has a terminal in the same
  /// container, so refusing them a pipe would buy nothing and cost every job
  /// that is honestly `npm run x | tee log`.
  command String

  /// A disabled job keeps its history and its schedule and stops firing.
  /// Deleting is the other thing, and it is not the same thing.
  enabled Boolean @default(true)

  /// When it next fires. Null when disabled, and null when the expression
  /// parses but matches no reachable instant — `0 0 30 2 *` is valid cron and
  /// will never happen.
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ScheduledRun[]

  /// The sweeper's whole query: enabled jobs that are due.
  @@index([enabled, nextRunAt])
  @@index([projectId])
  @@map("scheduled_jobs")
}

/// One execution of a scheduled job, kept so that "it did not run" and "it ran
/// and failed" are different answers.
///
/// A row is written when the run *starts*, not when it finishes, because the
/// interesting failure is the one that never finished — a run stuck in RUNNING
/// is visible, where a run recorded only on completion would be indistinguishable
/// from a run that never happened.
model ScheduledRun {
  id String @id @default(uuid())

  jobId String
  job   ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  status   ScheduledRunStatus @default(RUNNING)
  exitCode Int?

  /// The tail of stdout and stderr, truncated. The tail rather than the head
  /// because the useful line in a failed job is almost always the last one.
  output String?

  @@index([jobId, startedAt])
  @@map("scheduled_runs")
}

enum ScheduledRunStatus {
  RUNNING
  SUCCEEDED
  /// Exited non-zero.
  FAILED
  /// The previous run of the same job had not finished. Recorded rather than
  /// silently passed over, so an overlapping schedule looks like the
  /// misconfiguration it is instead of like a job that stopped firing.
  SKIPPED
  /// Gave up waiting. The command may still be running inside the container —
  /// this abandons the exec, it does not kill it.
  TIMED_OUT
  /// Could not start at all: no container, no Docker, project has no tree.
  ERRORED
  /// The server stopped existing mid-run. Distinct from ERRORED, which says
  /// the command never started: this one did, and may have finished.
  ABANDONED
}

/// Container-seconds, per account, per day.
///
/// What is limited in this product is disk and project count; what is
/// EXPENSIVE is container-hours, and nothing measured them. plan.md section
/// 8.8 asks whether this sells capability or sells minutes and cannot be
/// answered without a number, so this is the number.
///
/// Sampled, not sessioned. A startedAt/endedAt row is the obvious shape and it
/// is the restart wedge again (section 2.26): a row with an open end, a
/// process that stops existing, and a total that is wrong forever afterwards.
/// A sweep adds elapsed seconds to a day, so a restart loses at most one tick
/// and nothing is ever left open.
///
/// Recorded, never enforced. Nothing refuses anything on this.
/// What a subscription is doing right now, as the processor last described it.
///
/// One row per account, and the ONLY writer is the webhook. The post-checkout
/// redirect is a browser event -- it can be dropped, replayed, or hit by
/// somebody who never paid -- so it is not evidence of anything. This is
/// section 6 decision 13 in another costume: the guarantee lives where it
/// cannot be skipped.
///
/// The subscription does not decide what an account may do. It decides
/// `User.planId`, and everything else in this codebase already reads
/// entitlements from that -- which is section 8.0's whole point, that billing
/// writes one column.
model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SubscriptionStatus

  /// The plan this subscription is FOR, which is not always the plan the
  /// account is on: a past-due subscription past its grace is for `pro` and
  /// the account is on `free`. Keeping both is what makes recovery a status
  /// change rather than a guess about what somebody used to pay for.
  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  /// The processor's own ids. Nullable because a comped or manually created
  /// subscription has none, and because this deployment can hold subscription
  /// state before it has ever been given a key.
  customerId     String? @unique
  subscriptionId String? @unique

  /// When the paid period ends. What a cancellation counts down to: cancelling
  /// does not take away what has been paid for.
  currentPeriodEnd DateTime?

  /// When a failing payment stops being tolerated. Set when the status first
  /// becomes PAST_DUE and cleared when it recovers -- a state that outlives
  /// its cause is the defect section 2.26 is about.
  graceUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

/// A processor event that has already been applied.
///
/// Webhooks are at-least-once. A redelivery must not be applied twice, and
/// "we have probably not seen this one" is not a guarantee -- so the event id
/// carries a unique index and the second delivery loses to the database rather
/// than to a race.
model BillingEvent {
  /// The processor's event id, verbatim. The primary key on purpose: there is
  /// no second identity for this row, and a generated one would let two copies
  /// of the same event exist.
  id String @id

  type       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("billing_events")
}

enum SubscriptionStatus {
  /// Paid and current.
  ACTIVE
  /// Free period before the first charge. Entitled, exactly like ACTIVE.
  TRIALING
  /// A payment failed. Still entitled until `graceUntil` -- a card that
  /// expired on a Friday must not take somebody's work away on the Saturday.
  PAST_DUE
  /// Ended, by the customer or by the processor giving up. Not entitled.
  CANCELED
}

model ComputeUsage {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Midnight UTC of the day being counted. UTC and not the viewer's zone,
  /// because two servers disagreeing about when a day starts is a rounding
  /// error that compounds.
  day DateTime @db.Date

  /// Container-seconds. A project with a database runs two containers and
  /// counts twice, which is what it actually costs the host.
  seconds Int @default(0)

  @@unique([userId, day])
  @@index([day])
  @@map("compute_usage")
}

model Project {
  id       String @id @default(uuid())
  name     String
  /// Template id from the server-side template registry, e.g. "react-vite".
  template String @default("react-vite")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// When a moderator took this project down, or null.
  ///
  /// Distinct from `visibility` on purpose, and the distinction is the whole
  /// point. Visibility is the OWNER's switch -- `setProjectVisibility` calls it
  /// "a decision about who may read the source" -- so a takedown expressed as
  /// `visibility: PRIVATE` is a decision the person it was applied to can
  /// reverse in one request, which is what used to happen.
  ///
  /// Set, it does three things nothing else was doing: the owner cannot
  /// publish again, the deployment is not served, and the embed is not
  /// resolved. The last two are WHERE clauses rather than cleanup steps,
  /// because a guarantee that depends on a teardown having succeeded is not a
  /// guarantee.
  takenDownAt DateTime?

  /// When the owner deleted this project -- and the delete has not happened
  /// yet.
  ///
  /// The whole of the trash. `deleteProjectService` removes the container, the
  /// managed database AND its volume, the checkpoints, the cache volume, the
  /// published files and the working tree, and the only thing in front of it
  /// was a confirmation dialog. Now that body is a sweeper's, seven days
  /// later, and the button writes this column.
  ///
  /// Enforced in `getProjectAccess`, which every route and socket handler
  /// reaches through, plus the handful of surfaces that resolve a project
  /// WITHOUT a session -- the site, the embed, the share link, the job sweep.
  /// WHERE clauses rather than cleanup, for the reason the line above gives.
  deletedAt DateTime?

  /// Absolute host path of a folder this server did NOT create, when the
  /// project is one somebody opened rather than one this platform scaffolded.
  ///
  /// Null for every project made from a template or imported from GitHub, and
  /// those keep the original arrangement exactly: their tree is
  /// `PROJECTS_ROOT/<id>`, a directory this server owns outright. Set, it means
  /// the opposite — the tree was already there, it belongs to whoever runs this
  /// machine, and this platform is a visitor in it.
  ///
  /// That distinction is not cosmetic, because four things this codebase does
  /// to a working tree are only defensible when it owns the tree:
  /// `purgeProject` removes it recursively, `claimForSandbox` chowns it to the
  /// sandbox uid, the disk quota rations it, and fork/duplicate copy out of it.
  /// The first two would be destroying somebody's source directory and the
  /// third would be an editor refusing to save into their own free space, so
  /// each asks `isLocalProject` first.
  ///
  /// Unique because two rows pointing at one directory is two containers
  /// writing one tree with no owner, and nothing downstream is built to
  /// arbitrate that. Opening an already-open folder finds the existing project
  /// rather than making a second one.
  ///
  /// Constrained on the way in by `LOCAL_FOLDER_ROOTS`: the column holds an
  /// absolute path, so what may be written into it is the whole of the
  /// security question, and that check lives in `utils/localRoots.ts`.
  localPath String? @unique

  moderationActions ModerationAction[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Last time a socket or terminal attached; drives the idle container reaper.
  lastActiveAt DateTime?

  /// What `Run` executes, when the template's default is not right.
  ///
  /// Null means "use the template's". An imported repository is the case this
  /// exists for: the template is detected from the files, but a real project's
  /// own `npm run dev` is not in a fixed registry of templates, so it is read
  /// from its package.json at import and can be corrected afterwards.
  startCommand String?

  /// What the test panel runs, when the template's default is not right.
  ///
  /// Null means "use the template's", exactly like `startCommand`, and for the
  /// same reason: an imported repository's own test script is not in a fixed
  /// registry. A template with no default and a project with no override means
  /// this project has no test command, which the panel says rather than
  /// guessing -- running `npm test` in a Go project is a worse answer than
  /// asking.
  testCommand String?

  /// Environment variables injected into this project's container, as a JSON
  /// object of string values. Stored per project rather than in a file so they
  /// are not committed, exported, or visible in the file tree.
  envVars Json @default("{}")

  /// Secret in the share link, when one has been created. Null means the
  /// project is not shared by link at all; revoking clears it, which
  /// invalidates every link already handed out.
  shareToken String?     @unique
  /// What a link holder may do. EDITOR links are still named grants: redeeming
  /// adds the signed-in user as a collaborator the owner can see and demote,
  /// so a link never becomes an anonymous write credential.
  shareRole  ProjectRole @default(VIEWER)

  /// Whether anybody signed in may read this project and take a copy.
  ///
  /// PRIVATE by default and always: publishing a project puts its source in
  /// front of strangers, which is a decision its owner makes rather than one
  /// inherited from a default. PUBLIC grants the `visitor` level and nothing
  /// more -- read the files, fork them. It is deliberately BELOW `viewer`,
  /// because a named viewer may query the project's database and read its git
  /// history, and neither of those is what "public" is meant to mean.
  visibility ProjectVisibility @default(PRIVATE)

  /// The public project this one was forked from, if it was.
  ///
  /// Nullable and SetNull rather than Cascade: deleting an original must not
  /// delete the copies somebody else now owns and has since worked on. The
  /// link is provenance, not ownership.
  forkedFromId String?
  forkedFrom   Project?  @relation("ProjectForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks        Project[] @relation("ProjectForks")

  collaborators      ProjectCollaborator[]
  reports            ProjectReport[]
  deployment         Deployment?
  databaseConnection ProjectDatabaseConnection?
  managedDatabase    ManagedDatabase?
  embed              Embed?
  scheduledJobs      ScheduledJob[]

  @@index([ownerId])
  /// The gallery reads this, and only this.
  @@index([visibility])
  @@index([forkedFromId])
  /// Only the trash. Every other query asks for `deletedAt IS NULL`, which is
  /// almost every row; the index that helps is over the few that are not.
  @@index([deletedAt])
  @@map("projects")
}

enum ProjectVisibility {
  PRIVATE
  PUBLIC
}

/// A GitHub authorisation this server may act under.
///
/// Separate from `User.githubId`, which only records that an account signed in
/// with GitHub. This is the part that can *do* things — read repositories,
/// clone, push, open a pull request — and so it is a deliberate, separate
/// consent that can be revoked on its own without signing the person out.
model GithubConnection {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The OAuth token, encrypted with AES-256-GCM under SECRET_ENCRYPTION_KEY.
  /// Never the plaintext: unlike a password this cannot be hashed, because the
  /// whole point is to spend it later, so a leaked dump must hand over
  /// ciphertext and nothing more.
  tokenCipher String

  /// What GitHub actually granted, which is not always what was asked for —
  /// an organisation can withhold `repo`. Stored so the app can say which
  /// operation is unavailable and why, rather than failing at the API call.
  scopes String

  /// The GitHub login at the time of connecting, shown in the UI. The id on
  /// `User` remains the stable identifier.
  login String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_connections")
}

/// A project's build output, published to a public origin.
///
/// One row per project, replaced in place on each deploy: this is the
/// *current* state of a published site, not a build history. A history would
/// mean keeping every build's files, which is a disk budget nobody has agreed
/// to yet.
model Deployment {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The DNS label the site is served at. Generated, never chosen: a
  /// user-supplied one is a namespace to fight over and a phishing surface
  /// ("stripe-login"). Unique across the deployment, because it is the whole
  /// address.
  subdomain String @unique

  status DeploymentStatus @default(BUILDING)

  /// Static files copied out, or a container kept running behind the public
  /// origin. Recorded rather than derived from the template at read time: a
  /// template gaining a static build later must not change how an already
  /// published site is served.
  kind DeploymentKind @default(STATIC)

  /// What actually ran, and what was read afterwards. Recorded rather than
  /// looked up, so changing a template's defaults does not rewrite what a
  /// published site claims about itself.
  buildCommand String
  outputDir    String

  /// The container port a SERVICE deployment is proxied to. Null for a static
  /// one, which has no container behind it.
  port Int?

  /// Bytes published, so a quota has something to count.
  sizeBytes Int @default(0)

  /// Tail of the build's own output. Bounded before it is written -- a webpack
  /// build can emit megabytes, and this column is read on every panel open.
  log String @default("")

  /// Why the last attempt failed, or null.
  error String?

  /// When a build last went live. Null until one has: a row exists from the
  /// moment the first build starts, so that the subdomain is reserved before
  /// anything is published to it.
  deployedAt DateTime?

  /// A hostname the owner claims to control, pointed here with a CNAME.
  ///
  /// Unique across every deployment, because it is an address and two sites
  /// cannot answer at one. Unlike `subdomain` this is user-supplied, which is
  /// the whole reason for the three columns below it: the server has no reason
  /// to believe a claim about a name it did not generate.
  customDomain String? @unique

  /// The value the owner must publish in a TXT record to prove the claim.
  /// Generated when the domain is claimed and regenerated on every re-claim,
  /// so a token seen once cannot be replayed against a later claim.
  domainToken String?

  /// When the TXT record was last SEEN. Null means unverified, and an
  /// unverified domain is never served -- a claim is not an address.
  domainVerifiedAt DateTime?

  /// When the record was last LOOKED FOR, whatever the answer. Distinct from
  /// the line above because that is exactly the difference between "we have
  /// never checked" and "we checked and it was gone", and a re-check that
  /// cannot tell those apart cannot safely act on either.
  domainCheckedAt DateTime?

  /// Which release is being served, or null for a deployment published before
  /// releases existed (its files are still in the legacy site directory).
  ///
  /// A pointer rather than a copy, and that is what makes a rollback a
  /// database write instead of a file operation: every build keeps its own
  /// directory, and going back to one is changing which directory this names.
  /// Nothing is rebuilt, nothing is copied, and the previous build is exactly
  /// the bytes that were serving before -- not a fresh build of a source tree
  /// that has moved on since.
  liveReleaseId String?

  releases DeploymentRelease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deployments")
}

/// One published build, kept so it can be gone back to.
///
/// `Deployment` is the current state of a project's site and is mutated in
/// place; this is the history it used to throw away. Before it, a publish
/// overwrote its own predecessor and "put back the one that worked" had
/// nothing to put back.
///
/// Static releases own a directory of files. A SERVICE release does not: what
/// it published is a running container built from a source tree that has since
/// moved on, so its row is a record and not something to roll back to. Saying
/// that plainly is better than a rollback that silently rebuilds something
/// else.
model DeploymentRelease {
  id String @id @default(uuid())

  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  /// Copied from the deployment at publish time. A release has to keep naming
  /// its own directory even if the deployment is later removed and the row is
  /// read while its files are being cleaned up.
  subdomain String

  kind DeploymentKind

  /// What produced it, recorded rather than looked up: rolling back to a build
  /// means rolling back to what that build actually ran, and a template whose
  /// defaults changed since must not rewrite history.
  buildCommand String
  outputDir    String

  sizeBytes Int @default(0)

  /// Tail of that build's output, bounded before it is written.
  log String @default("")

  createdAt DateTime @default(now())

  /// Newest first, per deployment, is the whole read pattern.
  @@index([deploymentId, createdAt])
  @@map("deployment_releases")
}

enum DeploymentStatus {
  BUILDING
  LIVE
  FAILED
}

enum DeploymentKind {
  STATIC
  SERVICE
}

/// An external database a project's query editor is pointed at.
///
/// One per project: the editor addresses "this project's database" rather
/// than a URL, so the connection string never travels to the client and the
/// client can never name a host of its own choosing.
model ProjectDatabaseConnection {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The connection string, encrypted with AES-256-GCM under
  /// SECRET_ENCRYPTION_KEY. Never the plaintext: it carries a password that
  /// has to be spendable later, so a leaked dump must hand over ciphertext
  /// and nothing more. The same reasoning as GithubConnection.tokenCipher.
  urlCipher String

  /// "postgresql" or "mongodb". Kept in the clear so the UI can pick the
  /// right editor without opening the secret.
  engine String

  /// Host and port as displayed back to the user, so the panel can say which
  /// database it is talking to without decrypting anything. Credentials are
  /// deliberately not here.
  label String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_database_connections")
}

/// A database this platform runs for a project, in its own container.
///
/// A sidecar per project rather than a shared cluster, because its isolation
/// is structural — a separate container, a separate volume, its own
/// credentials — rather than a set of grants that all have to stay right, and
/// every mistake in the shared version is cross-tenant.
model ManagedDatabase {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// "postgres", and only that. A Mongo *sidecar* is deliberately out of
  /// scope — see `docs/ROADMAP.md` §3.3. The Mongo client shipped on its
  /// own, against a database the user already has.
  engine String

  /// The generated password, encrypted with AES-256-GCM under
  /// SECRET_ENCRYPTION_KEY. Generated rather than chosen, and never shown:
  /// it exists to be injected into the project's container, not typed.
  passwordCipher String

  /// Database name and the named Docker volume holding its data. The volume
  /// is recorded rather than derived so that deleting the project can remove
  /// it even if the naming scheme changes later.
  databaseName String
  volumeName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("managed_databases")
}

/// A read-only, unauthenticated view of a project, for framing in someone
/// else's page.
///
/// One row per project, because the token IS the embed: an owner who wants a
/// different token has revoked the old one, and rotating in place says that
/// plainly. Presentation (`view`, `activeFile`) lives here rather than only in
/// the URL so the owner can change their mind without editing every snippet
/// they have ever pasted.
model Embed {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The credential in the iframe's URL. 32 random bytes, base64url. Stored in
  /// the clear, unlike a refresh token, because it is not a secret the server
  /// verifies -- it is the address of a public thing, and the whole page it
  /// grants is meant to be read by strangers.
  token String @unique

  /// Which halves are shown: "code", "preview", or "split".
  view String @default("split")

  /// What the preview half frames: "none" or "deployment". Never a running
  /// container -- an anonymous page view must not be able to start one.
  preview String @default("deployment")

  /// Project-relative POSIX path of the file that opens first, or null for
  /// whichever the tree offers.
  activeFile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("embeds")
}

/// Something the platform needs to tell one person about.
///
/// A stored record FIRST, and mail only if mail happens to be configured. The
/// obvious implementation -- call the mailer where the event happens -- is
/// wrong here specifically: `lib/mailer.ts` falls back to a logging mailer
/// that reports an ERROR per message in production, so an install without
/// SMTP would turn every failing job into error spam and still leave its
/// users knowing nothing. The row is the feature. The email is a transport
/// that may not exist.
///
/// These are for USERS. Moderators are identified by `ADMIN_EMAILS` rather
/// than by a role column (§2.11 chose that deliberately), so a moderator need
/// not have a row in `users` at all and there is nothing here to hang their
/// notifications on. The review queue notifies by mail instead.
model Notification {
  id String @id @default(uuid())

  /// Cascade, unlike `ProjectReport.reporterId`: a report outlives its author
  /// because somebody else still has to act on it, and news addressed to a
  /// deleted account is addressed to nobody.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// Written when the notification is created, not rendered on read. What a
  /// message said must not change because the thing it described changed
  /// afterwards -- "Nightly backup started failing" is a statement about a
  /// moment, and a job later renamed or deleted does not make it untrue.
  title String
  body  String

  /// Where to go about it: a path in the web app, already including any query
  /// the destination needs. Null when there is nowhere useful to point.
  link String?

  readAt DateTime?

  /// When this also went out as mail, or null -- which covers three different
  /// cases deliberately left indistinguishable here: no mailer configured, an
  /// unverified address, or a send that failed. All three mean the same thing
  /// to the reader, and the log has the detail.
  emailedAt DateTime?

  createdAt DateTime @default(now())

  /// The unread badge and the list are the same query with and without a
  /// filter, newest first.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationKind {
  /// A job that was working has started failing. Sent on the TRANSITION, never
  /// on the state: thirty consecutive failures are one piece of news, and a
  /// message every night is how a feature meant to end silence earns itself a
  /// filter rule and re-creates it.
  JOB_FAILING

  /// ...and the recovery, which is news for the same reason.
  JOB_RECOVERED

  /// A moderator made this project private. The one action in the system taken
  /// against a user rather than for them, which is exactly why it must not be
  /// something they discover by finding their own project missing.
  PROJECT_UNPUBLISHED

  /// ...and the answer to an appeal, which is the same argument: the person a
  /// decision was made against is the person who has to hear it reversed.
  PROJECT_REINSTATED

  /// This account has crossed into the last fifth of one of its quotas. On the
  /// crossing, once. Being over it is a state and says nothing further, and
  /// dropping back under it is silent -- nobody was harmed by a wall they did
  /// not hit, and somebody who has just deleted a project knows they did.
  QUOTA_WARNING

  /// An operator changed this account's plan or its limits. The same argument
  /// the takedown notification makes: a decision taken about somebody, by
  /// somebody else, is one they have to hear about from us rather than
  /// discover from a refusal.
  PLAN_CHANGED

  /// A payment failed, or the subscription ended. Sent on the two moments a
  /// person can act on and never in between -- a renewal that works is not
  /// news. Neither message says anything has been taken away, because nothing
  /// is: a lapsed account is blocked at the boundary, not emptied.
  BILLING_PROBLEM
}

/// Everything that has happened to one project's moderation state, in order.
///
/// The queue records the report and its status. It did not record who acted,
/// when, or why — and unpublishing somebody's project is the one power in this
/// system exercised AGAINST a user rather than for them. A moderator could not
/// demonstrate they were fair and could not be shown to have been unfair.
///
/// The owner's appeal is in the same table as the operator's decisions, rather
/// than in one of its own. It is the same story and it only makes sense read
/// in order: taken down, appealed, reinstated. Two tables would be two halves
/// of one conversation.
model ModerationAction {
  id String @id @default(uuid())

  /// SetNull, not Cascade — for the reason `ProjectReport.reporterId` gives
  /// about its author. An audit trail that vanishes with its subject can be
  /// erased by deleting the subject, which is exactly the move it exists to
  /// make visible. `projectName` is copied for the same reason.
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String

  /// Which report occasioned this, when one did. A reinstatement follows an
  /// appeal rather than a report, and an appeal follows neither.
  reportId String?

  action ModerationActionType

  /// The email of whoever did it: an operator from `ADMIN_EMAILS` for a
  /// decision, the owner for an appeal. Stored rather than joined, because the
  /// record has to survive the account and because `ADMIN_EMAILS` is config —
  /// an operator removed from that list still did what they did.
  actor String

  /// Why. Optional for a decision and required by the API for a reinstatement,
  /// because "we put it back" without a reason is the half of the record that
  /// makes the other half unfalsifiable.
  reason String?

  createdAt DateTime @default(now())

  /// The trail for one project, oldest first, is the whole read pattern.
  @@index([projectId, createdAt])
  @@map("moderation_actions")
}

enum ModerationActionType {
  /// A moderator made the project private and took it down.
  ACTIONED
  /// A moderator looked and found nothing wrong.
  DISMISSED
  /// The owner asked for the takedown to be looked at again.
  APPEALED
  /// A moderator lifted a takedown. Restores the owner's CONTROL, not the
  /// project's visibility: what to do next is theirs to decide again.
  REINSTATED
}
