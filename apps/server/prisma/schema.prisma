generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  email String @unique

  /// Null for an account created through an identity provider, which has no
  /// password of its own to store.
  passwordHash String?

  /// Set once the address has been confirmed. Unverified accounts can still
  /// sign in — locking people out of a tool they just signed up for is worse
  /// than the risk — but the state is recorded so it can be acted on.
  emailVerifiedAt DateTime?

  /// GitHub's numeric user id, when the account is linked. Stable across
  /// username changes, which is why it and not the login is what is stored.
  githubId  String? @unique
  avatarUrl String?

  createdAt DateTime @default(now())

  projects      Project[]
  refreshTokens RefreshToken[]
  collaborations ProjectCollaborator[]
  tokens        UserToken[]
  githubConnection GithubConnection?

  @@map("users")
}

/// One-time tokens for flows that arrive by email.
///
/// A single table rather than one per purpose: they share every field, the
/// same hashing, the same expiry handling, and the same "used exactly once"
/// rule. Only the purpose differs.
model UserToken {
  id String @id @default(uuid())

  /// SHA-256 of the token. The value goes in the email and is never stored, so
  /// a leaked database does not hand over anyone's account.
  tokenHash String @unique

  purpose UserTokenPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

/// Someone other than the owner who may open a project.
model ProjectCollaborator {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())

  /// One row per person per project.
  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_collaborators")
}

enum ProjectRole {
  /// May read files and watch the preview. Cannot write, run, or open a shell.
  VIEWER
  /// Everything the owner can do except delete the project or manage access.
  EDITOR
}

/// One issued refresh token.
///
/// Refresh tokens used to be stateless JWTs, so signing out only cleared the
/// browser's cookie: anyone holding the value kept a working session for its
/// full lifetime, and a compromised account could not be cut off short of
/// rotating the signing secret and ending every session on the platform.
model RefreshToken {
  id String @id @default(uuid())

  /// SHA-256 of the token. The value itself is never stored, so a leaked
  /// database backup does not hand over live sessions.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set when the token is rotated or explicitly revoked. A token presented
  /// after this is a replay, and revokes its whole family — the standard
  /// signal that a token was stolen.
  revokedAt DateTime?

  /// Groups every token descended from one sign-in.
  familyId String

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id       String @id @default(uuid())
  name     String
  /// Template id from the server-side template registry, e.g. "react-vite".
  template String @default("react-vite")

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Last time a socket or terminal attached; drives the idle container reaper.
  lastActiveAt DateTime?

  /// What `Run` executes, when the template's default is not right.
  ///
  /// Null means "use the template's". An imported repository is the case this
  /// exists for: the template is detected from the files, but a real project's
  /// own `npm run dev` is not in a fixed registry of templates, so it is read
  /// from its package.json at import and can be corrected afterwards.
  startCommand String?

  /// Environment variables injected into this project's container, as a JSON
  /// object of string values. Stored per project rather than in a file so they
  /// are not committed, exported, or visible in the file tree.
  envVars Json @default("{}")

  /// Secret in the share link, when one has been created. Null means the
  /// project is not shared by link at all; revoking clears it, which
  /// invalidates every link already handed out.
  shareToken String? @unique
  /// What a link holder may do. EDITOR links are still named grants: redeeming
  /// adds the signed-in user as a collaborator the owner can see and demote,
  /// so a link never becomes an anonymous write credential.
  shareRole ProjectRole @default(VIEWER)

  collaborators ProjectCollaborator[]
  deployment    Deployment?
  databaseConnection ProjectDatabaseConnection?
  managedDatabase    ManagedDatabase?

  @@index([ownerId])
  @@map("projects")
}

/// A GitHub authorisation this server may act under.
///
/// Separate from `User.githubId`, which only records that an account signed in
/// with GitHub. This is the part that can *do* things — read repositories,
/// clone, push, open a pull request — and so it is a deliberate, separate
/// consent that can be revoked on its own without signing the person out.
model GithubConnection {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The OAuth token, encrypted with AES-256-GCM under SECRET_ENCRYPTION_KEY.
  /// Never the plaintext: unlike a password this cannot be hashed, because the
  /// whole point is to spend it later, so a leaked dump must hand over
  /// ciphertext and nothing more.
  tokenCipher String

  /// What GitHub actually granted, which is not always what was asked for —
  /// an organisation can withhold `repo`. Stored so the app can say which
  /// operation is unavailable and why, rather than failing at the API call.
  scopes String

  /// The GitHub login at the time of connecting, shown in the UI. The id on
  /// `User` remains the stable identifier.
  login String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("github_connections")
}

/// A project's build output, published to a public origin.
///
/// One row per project, replaced in place on each deploy: this is the
/// *current* state of a published site, not a build history. A history would
/// mean keeping every build's files, which is a disk budget nobody has agreed
/// to yet.
model Deployment {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The DNS label the site is served at. Generated, never chosen: a
  /// user-supplied one is a namespace to fight over and a phishing surface
  /// ("stripe-login"). Unique across the deployment, because it is the whole
  /// address.
  subdomain String @unique

  status DeploymentStatus @default(BUILDING)

  /// What actually ran, and what was read afterwards. Recorded rather than
  /// looked up, so changing a template's defaults does not rewrite what a
  /// published site claims about itself.
  buildCommand String
  outputDir    String

  /// Bytes published, so a quota has something to count.
  sizeBytes Int @default(0)

  /// Tail of the build's own output. Bounded before it is written -- a webpack
  /// build can emit megabytes, and this column is read on every panel open.
  log String @default("")

  /// Why the last attempt failed, or null.
  error String?

  /// When a build last went live. Null until one has: a row exists from the
  /// moment the first build starts, so that the subdomain is reserved before
  /// anything is published to it.
  deployedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deployments")
}

enum DeploymentStatus {
  BUILDING
  LIVE
  FAILED
}

/// An external database a project's query editor is pointed at.
///
/// One per project: the editor addresses "this project's database" rather
/// than a URL, so the connection string never travels to the client and the
/// client can never name a host of its own choosing.
model ProjectDatabaseConnection {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The connection string, encrypted with AES-256-GCM under
  /// SECRET_ENCRYPTION_KEY. Never the plaintext: it carries a password that
  /// has to be spendable later, so a leaked dump must hand over ciphertext
  /// and nothing more. The same reasoning as GithubConnection.tokenCipher.
  urlCipher String

  /// "postgresql" or "mongodb". Kept in the clear so the UI can pick the
  /// right editor without opening the secret.
  engine String

  /// Host and port as displayed back to the user, so the panel can say which
  /// database it is talking to without decrypting anything. Credentials are
  /// deliberately not here.
  label String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_database_connections")
}

/// A database this platform runs for a project, in its own container.
///
/// §7.3 chose a sidecar per project over a shared cluster because its
/// isolation is structural — a separate container, a separate volume, its own
/// credentials — rather than a set of grants that all have to stay right, and
/// every mistake in the shared version is cross-tenant.
model ManagedDatabase {
  id String @id @default(uuid())

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// "postgres" for now. Mongo needs its own driver and its own editor; see
  /// row 7b of the parity plan.
  engine String

  /// The generated password, encrypted with AES-256-GCM under
  /// SECRET_ENCRYPTION_KEY. Generated rather than chosen, and never shown:
  /// it exists to be injected into the project's container, not typed.
  passwordCipher String

  /// Database name and the named Docker volume holding its data. The volume
  /// is recorded rather than derived so that deleting the project can remove
  /// it even if the naming scheme changes later.
  databaseName String
  volumeName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("managed_databases")
}
