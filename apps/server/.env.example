PORT=3000
TERMINAL_PORT=4000

# Postgres (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://replit:replit@localhost:5433/replit_clone?schema=public"

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Origin allowed to call the API and open sockets.
WEB_ORIGIN="http://localhost:5173"

# Where project working trees live. Relative paths resolve from apps/server.
PROJECTS_DIR="projects"

# Command used to scaffold a new project. Runs on the HOST today (Phase 3
# replaces this with a template copy executed inside the container).
REACT_PROJECT_COMMAND="npm create vite@latest sandbox -- --template react"
