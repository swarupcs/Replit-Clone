# Single port: the terminal WebSocket and the preview proxy share it.
PORT=3000

# Postgres (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://replit:replit@localhost:5433/replit_clone?schema=public"

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# The preview cookie is sent to the project container, which runs untrusted
# code, so it is deliberately short-lived. Every session refresh reissues it.
PREVIEW_TOKEN_TTL_HOURS=12

# Origin allowed to call the API and open sockets.
WEB_ORIGIN="http://localhost:5273"

# Cookie policy for the refresh/preview cookies. Leave these as-is for local
# dev, for a same-domain deployment (e.g. docker-compose.prod.yml), and for
# the all-in-one Dokploy deployment (docker-compose.dokploy.yml -- Dokploy
# subdomains are still "same-site"). Only set these if the frontend and API
# end up on genuinely DIFFERENT registrable domains (e.g. Vercel + a separate
# API host) -- see docker-compose.dokploy-backend-only.yml.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# Where project working trees live. Relative paths resolve from apps/server.
PROJECTS_DIR="projects"

# Per-container resource budget. Defaults suit a 2-4 GB VM.
CONTAINER_MEMORY_MB=512
CONTAINER_CPUS=0.5
CONTAINER_IDLE_MINUTES=20
MAX_CONCURRENT_CONTAINERS=3
