# Single port: the terminal WebSocket and the preview proxy share it.
PORT=3000

# Postgres (see docker-compose.yml at the repo root)
DATABASE_URL="postgresql://replit:replit@localhost:15432/replit_clone?schema=public"

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# The preview cookie is sent to the project container, which runs untrusted
# code, so it is deliberately short-lived. Every session refresh reissues it.
PREVIEW_TOKEN_TTL_HOURS=12

# Origin allowed to call the API and open sockets.
WEB_ORIGIN="http://localhost:15273"

# This server's own public origin. Only used to build the absolute OAuth
# redirect_uri, which has to match what is registered with the provider.
API_ORIGIN="http://localhost:3000"

# GitHub sign-in. Leave both unset and the feature is simply off -- the web app
# asks /api/v1/auth/providers and hides the button.
# Register an OAuth app with the callback URL
#   <API_ORIGIN>/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Encrypts secrets this server has to keep and later spend -- today the GitHub
# token that makes importing a repository and pushing possible without pasting
# one in every time. 32 bytes, base64. Without it those features report
# themselves off; sign-in with GitHub is unaffected.
#   openssl rand -base64 32
# SECRET_ENCRYPTION_KEY=

# The AI assistant. Leave the key unset and the feature is simply off -- the web
# app asks /api/v1/ai/status and hides the panel, exactly like GitHub above.
# Get a key at https://console.anthropic.com/settings/keys. Usage is billed to
# that account, so the per-user hourly cap below is what stops one person
# spending the whole budget.
# ANTHROPIC_API_KEY=
# AI_MODEL="claude-sonnet-5"
# AI_MAX_TOKENS=4096
# AI_REQUESTS_PER_HOUR=60

# How many reverse proxies sit in front of this server. Rate limits key on the
# client address, and behind a proxy that address is the proxy's own unless
# this is set -- which makes one person's failed logins throttle everybody.
# 0 when nothing fronts it, 1 for a single nginx or Traefik, 2 behind
# Cloudflare in front of one of those. Never "trust every hop": a client can
# then forge the address it is limited as.
#
# Left at 0 with a proxy in front, the server says so the first time a request
# arrives carrying X-Forwarded-For -- once, in the log. It cannot know at boot,
# because a plain-HTTP proxy on a LAN looks exactly like no proxy at all.
TRUSTED_PROXY_HOPS=0

# Cookie policy for the refresh/preview cookies. Leave these as-is for local
# dev, for a same-domain deployment (e.g. docker-compose.prod.yml), and for
# the all-in-one Dokploy deployment (docker-compose.dokploy.yml -- Dokploy
# subdomains are still "same-site"). Only set these if the frontend and API
# end up on genuinely DIFFERENT registrable domains (e.g. Vercel + a separate
# API host) -- see docker-compose.dokploy-backend-only.yml.
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true

# The Domain put on the PREVIEW cookie, so it reaches a preview origin that is
# a different HOSTNAME rather than a different port.
#
# Empty -- the default -- is right for everything above: locally and in the
# compose stacks the API and the previews share a host and differ only by port,
# and cookies ignore ports, so the cookie already travels.
#
# Behind a reverse proxy it does not. `api.example.com` and
# `preview.example.com` are two hosts; a host-only cookie set on the first is
# never sent to the second, so previewGuard answers "No preview session" for
# every request. Nothing reports it -- the browser stores the cookie and
# declines to send it -- so you are signed in, the editor works, and the
# preview pane is empty. Set this to the domain the two share.
#
# The REFRESH cookie deliberately does not take it: that one is spent only at
# this server's own /api/v1/auth path, so widening a session credential to
# every sibling name would buy nothing.
#
# Published sites must not sit under this domain -- they are arbitrary user
# code and would receive the cookie. The server refuses to start on that
# combination, along with several others a browser would break silently; see
# src/config/exposure.ts and docs/EXPOSING.md.
# COOKIE_DOMAIN=example.com

# --- Single-user mode -------------------------------------------------------
#
# Leave SINGLE_USER_EMAIL unset -- the default -- and nothing below applies:
# people sign up, verify an address, reset a password and sign in with GitHub,
# exactly as they always have.
#
# Set it, and this server has exactly one account, created at boot from this
# address. The routes that CREATE or RECOVER an account are then not mounted at
# all -- no signup, no password reset, no email verification, no GitHub
# sign-in. Not "mounted and refusing": there is no handler, so there is no
# check for a later route to forget.
#
# That removes the way back into a forgotten password, so this file replaces
# it: set SINGLE_USER_PASSWORD and restart. Boot rewrites the password every
# time it is set, which makes the environment the recovery mechanism instead of
# an inbox -- and a personal deployment usually has no outbound mail path, so
# "forgot password" there was never a way back in to begin with.
#
# Sign-in itself stays, and is not optional. Every route in this product
# authenticates through a session; a server that issued one to anybody who
# asked would be an unauthenticated server on whatever network it can be
# reached from.
#
# Leave SINGLE_USER_PASSWORD unset on a first boot and one is generated and
# written to the log once. Leave it unset on a later boot and the existing
# password is kept, so the variable can be removed once it has been used.
#
# Connecting GitHub to reach your REPOSITORIES is a different consent on a
# different route and is unaffected -- importing a repository still works.
# SINGLE_USER_EMAIL="me@example.com"
# SINGLE_USER_PASSWORD="something-long"

# Setting SINGLE_USER_EMAIL also changes three defaults, because it answers a
# question NODE_ENV was standing in for: whether anything here is SHARED.
#
#   - The per-account limits become the `personal` plan's, which are unlimited.
#     Twenty projects and 2 GB across them ration a VM between tenants, and
#     there is nobody here to ration against. The MACHINE's limits are
#     untouched -- see CONTAINER_MEMORY_MB and MAX_CONCURRENT_CONTAINERS below,
#     which no plan may raise, because a promise of more memory than the host
#     has is kept by an OOM kill rather than by an honest refusal.
#   - CONTAINER_MEMORY_MB and CONTAINER_CPUS take the development figures
#     (2048 MB / 2 CPUs) rather than the deployment ones. Same reason: 512 MB
#     and half a core protect headroom from other tenants who are not there.
#   - LSP_ENABLED defaults ON. It is off by default because the image size is
#     "paid on every cold start by people who never open a .py or .go file",
#     and on a single-seat deployment there are no such people. Rebuild the
#     images first (`pnpm images:build`), or set LSP_ENABLED=false.
#
# Every one of the three is still overridable by setting it explicitly.

# It also switches off the surface that needs a second person. Sharing, the
# report queue and the operator console, and the public gallery are not mounted
# at all -- none of them is a preference, each is dead by arithmetic: a share
# link is redeemed by a second account, a report needs a reporter and a separate
# operator, the console administers accounts, and the gallery lists what OTHER
# people published.
#
# Still there, because each has a real user at n=1: embeds (your own project in
# your own blog post), deployments and custom domains, API keys (a personal
# build server is an ordinary setup), scheduled jobs, notifications, the
# assistant, the database panel, GitHub, checkpoints and the trash.

# development | test | production. Production turns on the strict cookie and
# error-reporting behaviour; nothing else reads it.
NODE_ENV=development

# How the preview proxy reaches a project's dev server.
#
#   container-ip   dial the container on the sandbox network. Requires THIS
#                  server to be on that network too, i.e. running under docker
#                  compose. Nothing is published to the host at all.
#   host-loopback  publish the dev port on 127.0.0.1 and dial that. Needed when
#                  the server runs directly on a Windows or macOS host, where
#                  Docker Desktop gives the host no route to container IPs.
#
# Left unset this is inferred from whether this process is itself inside a
# container, which is right for both ordinary cases.
# PREVIEW_TARGET_MODE=container-ip

# Where project working trees live. Relative paths resolve from apps/server.
PROJECTS_DIR="projects"

# Directories a folder may be OPENED from, comma separated. Empty -- the
# default -- turns the feature off entirely.
#
# Every other way into this editor creates the tree first: a template is copied
# or a repository is cloned, and either way the result is a directory this
# server made and owns. Setting this allows the other route -- opening a folder
# that is already on the disk, edited in place, never copied.
#
# Read this before setting it. A folder that is opened is bind-mounted into a
# container that runs arbitrary code as a user who can write it, and its
# contents are readable by anybody who can read the project. So this is not a
# convenience setting: it names exactly which parts of the host this server may
# hand to a sandbox.
#
# Leave it EMPTY on any deployment with more than one account on it. It exists
# for the single-seat case, where the operator and the user are the same person
# and the folders are already theirs.
#
# Enforced against the path a symlink actually resolves to, not the name it was
# reached by, and PROJECTS_ROOT is refused even when it sits inside a named
# root.
# LOCAL_FOLDER_ROOTS="/home/me/code,/home/me/work"

# Per-container resource budget.
#
# Left unset these follow NODE_ENV, because the two cases are not the same
# problem. A deployment is packing other people's projects onto a shared VM and
# gets 512 MB / 0.5 CPU, which suits a 2-4 GB box. Development is one tenant on
# a far larger machine, where those figures are paid on every cold start -- a
# first `npm install` and a first Vite transform on half a core feel broken
# rather than slow -- so it gets 2048 MB / 2 CPUs instead.
#
# Set them only to override that. Uncommenting the deployment figures here is
# what used to give a developer a 512 MB container on a 32 GB machine.
# CONTAINER_MEMORY_MB=512
# CONTAINER_CPUS=0.5
CONTAINER_IDLE_MINUTES=20
# Ceiling on one project's working tree. Enforced on every write the editor
# makes; a command run in the project's own terminal is not intercepted, so
# treat this as a guard against runaway editing rather than a hard disk quota.
PROJECT_DISK_QUOTA_MB=512
MAX_CONCURRENT_CONTAINERS=3

# Disk a managed database's volume may hold, per project. Its own line rather
# than a share of PROJECT_DISK_QUOTA_MB above: a database is the easiest way in
# this product to fill a disk, and it fills a different one -- a named Docker
# volume rather than the project tree.
DATABASE_DISK_QUOTA_MB=1024

# Periodic file snapshots, so an uncommitted mistake is recoverable. On by
# default; set to "false" or "0" to turn them off. The cost is bounded by the
# retention window rather than open-ended.
CHECKPOINTS_ENABLED=true

# --- Language intelligence --------------------------------------------------
#
# Diagnostics, completion and hover for languages Monaco cannot analyse in the
# browser. TypeScript and JavaScript already have a worker in the page and are
# unaffected by any of this; Python and Go get a real `pylsp` or `gopls`
# running inside the project's own container, where the imports resolve and the
# toolchain already lives.
#
# OFF by default, because the servers are baked into the sandbox images and the
# size is paid on every cold start including by people who never open a .py or
# .go file. Measured: sandbox-python 307 MB -> 338 MB, sandbox-go 1.31 GB ->
# 1.36 GB. Rebuild the images (`pnpm images:build`) after turning this on --
# an image without the binary refuses the language rather than failing oddly.
LSP_ENABLED=false

# Below this container memory limit a language server is refused, with a
# message saying so, rather than started. A server idles in the low hundreds of
# MB, and CONTAINER_MEMORY_MB defaults to 512 in a deployment -- so starting
# one unconditionally means it competes with the dev server it exists to help,
# and an OOM-killed dev server is a far worse experience than an editor
# explaining why it has no intelligence here. Development's larger default
# clears this bar on its own.
# LSP_MIN_CONTAINER_MEMORY_MB=1024

# Per-user limits. Without these one account can take every container slot and
# fill the disk on its own, however generous the global caps are.
MAX_PROJECTS_PER_USER=20
USER_DISK_QUOTA_MB=2048
MAX_CONTAINERS_PER_USER=2

# --- Sandbox egress ---------------------------------------------------------
#
# Cut the sandbox network off from everything except a filtering gateway.
#
# With this OFF (the default) a project container has ordinary outbound
# networking: the internet, which it needs to install packages, and with it the
# host's LAN, the cloud instance metadata endpoint that hands out credentials to
# anything that asks, and in the compose deployment this server's own API.
#
# With it ON the sandbox bridge is created `Internal: true` -- no route off it
# at all -- and a small gateway container (`sandbox-egress:latest`) is the only
# way out. It refuses private addresses, so code that respects HTTPS_PROXY gets
# a working `npm install` and code that ignores it finds no route.
#
# Requires `pnpm images:build` to have built the gateway image. Off by default
# only so an existing deployment does not lose package installs on upgrade;
# new deployments should turn it on.
#
# NOT compatible with PREVIEW_TARGET_MODE=host-loopback, which is the default
# when this server runs directly on your machine rather than in a container.
# Docker does not publish ports for a container on an internal network, so the
# preview proxy would have nothing to dial and every preview would report that
# nothing is running. The server refuses to start on that combination rather
# than let you find out from the symptom. Leave this off for local development.
SANDBOX_EGRESS_FILTERED=false
EGRESS_IMAGE=sandbox-egress:latest
# Domain suffixes a sandbox may reach. Empty means any PUBLIC address -- the
# private-address floor holds either way. Set this only if you can enumerate
# every registry, CDN and git host your users' projects legitimately need.
EGRESS_ALLOW_DOMAINS=
# Ports a sandbox may reach, whatever the destination. A public address is not
# automatically a safe one: port 25 from this platform's IP is somebody else's
# spam problem.
EGRESS_ALLOW_PORTS=80,443,9418

# Start a project's dev server as soon as somebody opens it, rather than
# waiting for the Run button. Every template's start command installs its
# dependencies first, so this covers `npm install` too.
#
# Worth turning off on a small VM: it turns "opened a project" into a
# container, an install and a dev server. An explicit Stop always wins over
# it either way, and is remembered until the project is run again by hand.
# Off by default: a dev server nobody asked for holds the port, so running the
# start command yourself fails with EADDRINUSE against a process you did not
# know existed. Set it to true to have opening a project start the server.
AUTO_START_ON_OPEN=false

# Make the sandboxes' dev servers POLL for file changes instead of waiting to
# be told about them.
#
# A project's files are bind-mounted from the host. A Linux host carries
# inotify across that mount, so watchers work normally. Docker Desktop on
# Windows and macOS does not: the container sees the new contents immediately,
# but no event ever arrives, so Next/Vite/tsx never recompile and the preview
# sits on the previous version of the page even though the save worked.
#
# Left unset this is inferred from the host, which is right for both the
# ordinary cases. Set it explicitly for one that cannot be inferred — WSL2 with
# the project on a Windows drive looks like Linux from here and behaves like
# Windows, so it wants "true".
#
# Polling is not free: every watcher stats every watched file on an interval.
# WATCH_POLLING=true

# Port serving project previews, on an origin of its own.
#
# Previews must not share the API's origin: a project's code -- and everything
# it installs -- would run same-origin with the API and could mint itself a
# session from the refresh cookie. A separate origin is also what lets the
# editor grant the preview iframe `allow-same-origin`; without it the frame is
# opaque, every module script in it fails CORS, and a client-rendered app shows
# a blank pane while a server-rendered one appears to work.
#
# Defaults to PORT + 1. Set to 0 to serve previews from the API's own origin
# and accept both consequences.
# PREVIEW_PORT=3101

# The public origin previews are reachable at, when that is not simply this
# server's host on PREVIEW_PORT.
#
# Needed once a reverse proxy is in front, because the three origins are then
# three NAMES and the server can no longer derive this. Nothing routes by it --
# the proxy does -- but the boot check cannot see the whole picture without it,
# and that check is what stands between a mistake in COOKIE_DOMAIN and every
# preview silently answering "No preview session".
# PREVIEW_ORIGIN="https://preview.example.com"

# --- Dev Containers ----------------------------------------------------------

# A project may carry .devcontainer/devcontainer.json, which is how a real
# repository says it needs ffmpeg, a Postgres client, or a different Node than
# the template's image ships. A deliberate subset of the spec is honoured;
# everything else is reported to the user rather than ignored.

# Images a devcontainer may ask for, comma-separated. A trailing * is a prefix
# wildcard.
#
# An allowlist rather than "anything on Docker Hub", because `image` decides
# what code runs in the sandbox and pulling an arbitrary one is unbounded disk
# and bandwidth on top of a supply-chain decision nobody made.
#
# The default is this platform's own images, which is the conservative reading:
# a devcontainer can still set env, ports, a workspace folder and install
# packages in postCreateCommand -- most of what one is for -- without this
# deployment having agreed to run somebody else's image. Widen it deliberately,
# e.g. to also trust the Microsoft-maintained images:
#   DEVCONTAINER_IMAGE_ALLOWLIST="sandbox-node:latest,sandbox-python:latest,sandbox-go:latest,mcr.microsoft.com/devcontainers/*"
# DEVCONTAINER_IMAGE_ALLOWLIST="sandbox-node:latest,sandbox-python:latest,sandbox-go:latest"

# Longest a devcontainer's postCreate/postStart commands may run. They sit in
# the path of opening a project and they are arbitrary commands out of a file in
# the repository, so a `sleep infinity` in one must not hold a start open.
DEVCONTAINER_LIFECYCLE_TIMEOUT_MINUTES=10

# --- Deployments -------------------------------------------------------------

# Port serving published sites, on a THIRD origin.
#
# It cannot be the API's, for the reason previews cannot: a published site is
# arbitrary user code. It cannot be the PREVIEW origin either, which is the less
# obvious half -- a preview is authenticated by a cookie scoped to that origin,
# so a public site sitting beside it would be same-origin with a page carrying a
# live preview credential.
#
# Defaults to PORT + 2. Set to 0 to turn deployments off: the endpoints then
# refuse rather than publishing to a listener nothing is running.
# DEPLOY_PORT=3102

# The public origin sites hang off, WITHOUT a subdomain. Each site is served at
# <generated-label>.<this host>.
#
# This is the one part of the feature a real deployment has to arrange: the host
# needs a wildcard DNS record, and over HTTPS a wildcard certificate. Locally
# neither is needed -- browsers resolve every *.localhost name to loopback
# themselves, per RFC 6761.
#
# Defaults to http://localhost:<DEPLOY_PORT>.
# DEPLOY_ORIGIN="https://sites.example.com"

# Where published output is written. Outside PROJECTS_DIR deliberately: what is
# served to the public must not sit under a path a project's own code can write
# to.
DEPLOYMENTS_DIR="deployments"

# Ceiling on one published site, and on how long its build may run.
#
# A deployment outlives its container and the idle reaper, so unlike the project
# quota this is disk that nothing reclaims on its own. A build over the cap is
# refused before a byte is copied.
DEPLOY_MAX_MB=100
DEPLOY_BUILD_TIMEOUT_MINUTES=10

# --- Always-on deployments ---------------------------------------------------
#
# The templates that answer requests from a running process -- Express, Flask,
# FastAPI, Go -- have no directory of files to publish. Publishing one keeps a
# container of its own running and the public origin proxies to it, so unlike a
# static site it holds memory for as long as it stays published and can crash on
# its own. Nothing here needs turning on: a project gets this shape only when
# its template has no static build.
#
# Per published service. Deliberately smaller than a development container:
# these are always up, several run at once, and nobody is sitting in front of
# one.
DEPLOY_MEMORY_MB=512
DEPLOY_CPUS=0.5

# How many may run at once. A budget of its own rather than a share of
# MAX_CONCURRENT_CONTAINERS, which exists so an interactive project can always
# be opened -- counting always-on containers against that means enough
# publishing makes the editor unusable.
MAX_DEPLOYED_SERVICES=5

# How many of those one account may hold. Without this the host-wide cap above
# is first-come-first-served: one user publishing five apps takes every slot
# and everybody else is refused a resource they never got a share of.
MAX_DEPLOYED_SERVICES_PER_USER=2

# How long a published app gets to answer on its port before the deploy is
# called failed. This window contains a cold `npm install` or `pip install` on
# half a core, so it is generous on purpose: too short reports an app that was
# merely still installing as broken.
DEPLOY_READY_TIMEOUT_MS=300000

# --- Not read from this file -------------------------------------------------

# A throwaway Postgres for the suites that exercise real rows (project access,
# the stored GitHub connection, the access watcher). They skip themselves when
# it is unset, which is why the workspace goes green without a database.
#
# It must come from the SHELL, not from here: `config/env.ts` deliberately
# skips dotenv when NODE_ENV=test, so that a developer's own .env cannot leak
# into the suite. Run it as
#   TEST_DATABASE_URL="postgresql://..." pnpm --filter @replit-clone/server test

# Host directories a devcontainer's "mounts" may bind, comma separated.
# Empty -- the default -- refuses every mount whatever the plan says.
#
# Unlike every other limit here, the request does not come from the user: it
# comes from a file inside the repository, which may have been cloned from a
# stranger. So an allowlist, and an empty one means refuse rather than allow.
# Set it to directories that are already yours -- a credentials folder, a
# dataset -- and never to a parent of anything you would not hand to a
# container running code you have not read.
DEVCONTAINER_MOUNT_ROOTS=
